# AI_MODE controls the retail copilot. Default is local, which never sends store data outside this server.
# Use "local" for the built-in local rules engine. Use "gemini" or "auto" only when you explicitly want Gemini.
AI_MODE="local"

# Optional. Required only when AI_MODE is "gemini" or "auto".
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
